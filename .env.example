# OpenRouter (https://openrouter.ai) — used by the data agent, the LLM self-estimate baseline
# and the "2nd LLM" agent variant. Leave empty to run with the rule parser / composition search fallback.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_MODEL_2=google/gemini-2.0-flash-001
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
